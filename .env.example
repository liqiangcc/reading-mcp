# OpenAI Secure MCP Tunnel (stdio transport)
CONTROL_PLANE_API_KEY=sk-...
TUNNEL_ID=replace-with-tunnel-id
PROFILE=replace-with-profile-name

# Optional: allow reading local documents from these directories.
# READING_MCP_LOCAL_ROOTS=/root/books:/root/docs

# Streamable HTTP transport.
# Generate a strong token, for example: openssl rand -hex 32
# READING_MCP_HTTP_TOKEN=replace-with-at-least-32-characters
# READING_MCP_HTTP_BIND=127.0.0.1:8787

# Keep the server bound to loopback. If a trusted tunnel/reverse proxy forwards
# a public Host or browser Origin, explicitly allow only those exact values.
# READING_MCP_HTTP_ALLOWED_HOSTS=docs-mcp.example.com
# READING_MCP_HTTP_ALLOWED_ORIGINS=https://chat.example.com

# Original PDF source-view limits.
# READING_MCP_SOURCE_VIEW_MAX_DPI=144
# READING_MCP_SOURCE_VIEW_MAX_WIDTH=2400
# READING_MCP_SOURCE_VIEW_MAX_HEIGHT=3200
# READING_MCP_SOURCE_VIEW_MAX_PIXELS=4000000
# READING_MCP_SOURCE_VIEW_MAX_IMAGE_BYTES=8388608
# READING_MCP_SOURCE_VIEW_MAX_DECODED_STREAM_BYTES=16777216
# READING_MCP_SOURCE_VIEW_TIMEOUT_SECS=10
